{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "vite.config.ts",
    "types.ts",
    "utils/**/*.ts",
    "game/**/*.ts",
    "tv/**/*.ts",
    "admin/**/*.ts"
  ]
}
